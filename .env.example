# Copy to .env.local for local development. Never commit the real file —
# .env, .env.local, and every other .env* variant are gitignored; this
# file holds placeholder names only, no real values.
#
# See docs/16-database-operations.md for where these come from (Neon +
# Vercel) and how to rotate them.

# Pooled Neon connection — used by the running app (src/server/db.ts).
# Set automatically by Vercel's Neon marketplace integration in every
# connected environment; only needed here for local development.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (unpooled) Neon connection — used only by the Prisma CLI
# (migrate, db pull, studio), via prisma.config.ts. Migrations need
# session-level features a pgbouncer pooled connection doesn't support.
# Vercel's Neon integration names this DATABASE_URL_UNPOOLED, not
# DIRECT_URL — prisma.config.ts checks DIRECT_URL first, then falls back
# to DATABASE_URL_UNPOOLED, so either name works.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Founder's own login — read by prisma/seed.ts to grant the initial
# StaffMembership(role: "founder"). Never hardcode a real email into a
# committed file.
FOUNDER_EMAIL="you@3stoneai.com"

# Signs every session cookie (src/lib/session.ts) — a long random string,
# unique per environment. Generate with: openssl rand -hex 32
# Rotating this immediately logs every signed-in user out everywhere
# (every existing cookie's signature stops verifying), so treat it as a
# real secret, not a placeholder to copy between environments.
SESSION_SECRET="generate-a-long-random-string-do-not-reuse-across-environments"

# Google OAuth + Picker. Client ID and project number identify the OAuth
# app; the client secret stays server-side. Picker API keys are designed
# for browser use and must be restricted in Google Cloud to the Picker API
# and the app's exact HTTPS origins.
GOOGLE_CLIENT_ID="google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="google-oauth-client-secret"
GOOGLE_PICKER_API_KEY="browser-key-restricted-to-picker-and-app-origins"
GOOGLE_CLOUD_PROJECT_NUMBER="123456789012"
# Preview-only: request just drive.file while validating the isolated Google
# verification project. Do not set this in production.
GOOGLE_DRIVE_PICKER_TEST_MODE="false"

# Encrypts every stored customer OAuth token and integration API key.
# Use a dedicated 32-byte value and keep it stable across deployments.
INTEGRATION_TOKEN_ENCRYPTION_KEY="generate-a-dedicated-32-byte-key"

# Microsoft Entra multi-tenant OAuth.
MICROSOFT_CLIENT_ID="microsoft-entra-application-client-id"
MICROSOFT_CLIENT_SECRET="microsoft-entra-client-secret"

# Slack OAuth application.
SLACK_CLIENT_ID="slack-application-client-id"
SLACK_CLIENT_SECRET="slack-application-client-secret"

# Monday.com OAuth application.
MONDAY_CLIENT_ID="monday-application-client-id"
MONDAY_CLIENT_SECRET="monday-application-client-secret"

# Salesforce External Client App.
SALESFORCE_CLIENT_ID="salesforce-consumer-key"
SALESFORCE_CLIENT_SECRET="salesforce-consumer-secret"

# Basecamp OAuth application. Optional until the founder registers the app.
BASECAMP_CLIENT_ID="basecamp-oauth-client-id"
BASECAMP_CLIENT_SECRET="basecamp-oauth-client-secret"
